{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npm",
        "exec",
        "--no-install",
        "--",
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "permission": {
    "edit": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "composer install*": "ask",
      "composer update*": "ask",
      "rm -rf *": "ask"
    }
  }
}
